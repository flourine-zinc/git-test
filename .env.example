# Frontend env vars must be prefixed with VITE_ to reach the client bundle.

# Optional override for the API base URL.
# Dev (unset): http://localhost:4000/api/v1
# Prod (unset): https://git-test-vnpu.onrender.com/api/v1
# Prod (set to real https): overrides the Render default.
# Never set localhost for production - the build rejects it.
VITE_API_URL=