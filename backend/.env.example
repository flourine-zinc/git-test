# --- PostgreSQL (Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# If unset: development → http://localhost:4000/api/v1/auth/google/callback
#            production  → https://git-test-vnpu.onrender.com/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# --- Session ---
SESSION_COOKIE_NAME="quest_session"
SESSION_SECRET="change-this-to-a-long-random-string"
SESSION_MAX_AGE_DAYS="30"

# --- Server ---
PORT="4000"
# Comma-separated list of allowed frontend origins. Do NOT add a trailing slash —
# the cors package matches browser Origin headers exactly, and browsers never
# send a trailing slash. Example (production):
#   CORS_ORIGINS="https://your-app.vercel.app,https://another-origin.com"
# If unset: development → http://localhost:5173
#           production  → https://git-test-flourine-zincs-projects.vercel.app
CORS_ORIGINS="http://localhost:5173"
# If unset: development → false, production → true (SameSite=None + Secure,
# which is mandatory for the cross-site Vercel ↔ Render session cookie).
COOKIE_SECURE="false"
NODE_ENV="development"

# --- Frontend redirect ---
# Where Google's OAuth callback redirects the browser after login.
# - Development: "auto" (or missing) resolves to http://localhost:5173
# - Production: MUST be the absolute deployed URL, e.g. "https://your-app.vercel.app"
#   If unset or "auto" while NODE_ENV=production, it safely resolves to
#   https://git-test-flourine-zincs-projects.vercel.app — NEVER localhost.
APP_REDIRECT_URL="auto"
