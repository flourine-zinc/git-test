# --- PostgreSQL (Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# --- Session ---
SESSION_COOKIE_NAME="quest_session"
SESSION_SECRET="change-this-to-a-long-random-string"
SESSION_MAX_AGE_DAYS="30"

# --- Server ---
PORT="4000"
CORS_ORIGINS="http://localhost:5173"
COOKIE_SECURE="false"
NODE_ENV="development"

# --- Frontend redirect ---
# Where Google's OAuth callback redirects the browser after login.
# "auto" (or missing) resolves to http://localhost:5173 in development.
# Set the production URL explicitly, e.g. "https://your-app.com"
APP_REDIRECT_URL="auto"
